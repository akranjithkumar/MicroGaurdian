          <div class="score-sub">Confidence: <span id="dist-conf">HIGH</span> | Uncertainty: +/-<span id="dist-unc">0.02</span></div>
        </div>
        <div class="progress-bar-bg">
          <div id="dist-bar" class="progress-bar-fill" style="width: 100%; background: var(--accent-cyan);"></div>
